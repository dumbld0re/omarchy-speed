{
  "schemaVersion": 1,
  "id": "danny-miguel.speed",
  "name": "Speed",
  "version": "0.1.0",
  "author": "Danny-Miguel",
  "license": "MIT",
  "description": "Internet speed in the bar via fast.com: live download/upload tests, latency, bufferbloat grade and history.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Speed",
    "description": "Last download speed; click for details, history and a live test.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "autoTestMinutes": 0,
      "showUpload": false
    },
    "schema": [
      {
        "key": "autoTestMinutes",
        "type": "integer",
        "label": "Test automatically every N minutes (0 = off)",
        "min": 0,
        "max": 1440,
        "step": 15,
        "defaultValue": 0
      },
      {
        "key": "showUpload",
        "type": "boolean",
        "label": "Show upload in the bar",
        "defaultValue": false
      }
    ]
  }
}
