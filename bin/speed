#!/bin/sh
# Runs the bundled `speed` CLI. Prefers a compiled binary on ~/.local/bin,
# otherwise runs the TypeScript source in ../cli with Bun.
if [ -x "$HOME/.local/bin/speed" ]; then
  exec "$HOME/.local/bin/speed" "$@"
fi

here=$(dirname "$(readlink -f "$0")")
bun=$(command -v bun 2>/dev/null)
[ -z "$bun" ] && [ -x "$HOME/.bun/bin/bun" ] && bun="$HOME/.bun/bin/bun"

if [ -z "$bun" ]; then
  echo '{"event":"error","message":"Needs Bun: omarchy pkg add bun"}'
  echo "speed: Bun is not installed. Run: omarchy pkg add bun" >&2
  exit 127
fi

exec "$bun" "$here/../cli/src/index.ts" "$@"
