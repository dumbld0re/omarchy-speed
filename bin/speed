#!/bin/sh
# Runs the `speed` CLI bundled with this plugin, never one from elsewhere on
# the system. Uses the optional compiled binary at ../cli/dist/speed (built by
# `bun run build` inside cli/), otherwise runs ../cli/src/index.ts with Bun.
here=$(dirname "$(readlink -f "$0")")
cli="$here/../cli"

if [ -x "$cli/dist/speed" ]; then
  exec "$cli/dist/speed" "$@"
fi

bun=$(command -v bun 2>/dev/null)
[ -z "$bun" ] && [ -x "$HOME/.bun/bin/bun" ] && bun="$HOME/.bun/bin/bun"

if [ -z "$bun" ]; then
  echo '{"event":"error","message":"Needs Bun, see README"}'
  echo "speed: Bun is not installed (see the plugin README)" >&2
  exit 127
fi

exec "$bun" "$cli/src/index.ts" "$@"
