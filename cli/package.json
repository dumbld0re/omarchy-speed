{
  "name": "fast-cli",
  "version": "0.1.0",
  "description": "fast.com in your terminal — download, upload, latency, bufferbloat, history",
  "type": "module",
  "bin": { "speed": "src/index.ts" },
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/speed",
    "install-bin": "bun run build && install -m755 dist/speed ~/.local/bin/speed"
  },
  "devDependencies": { "@types/bun": "latest" }
}
